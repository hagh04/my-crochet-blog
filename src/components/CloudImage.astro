---
/**
 * Renders an external image from a URL.
 * Used as a custom MDX component in Keystatic content.
 * Automatically injects Cloudinary transforms for optimized delivery.
 */

interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src: rawSrc, alt, caption } = Astro.props;

function optimizeCloudinaryUrl(url: string): string {
  if (!url || !url.includes('cloudinary.com') || !url.includes('/upload/')) return url || "";
  if (url.includes('f_auto')) return url;
  return url.replace('/upload/', '/upload/f_auto,q_auto,w_800/');
}

const src = optimizeCloudinaryUrl(rawSrc);
---

<figure class="my-8">
  <div class="overflow-hidden rounded-md">
    <img
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="w-full"
    />
  </div>
  {caption && (
    <figcaption class="mt-2 text-center text-sm text-muted-foreground">
      {caption}
    </figcaption>
  )}
</figure>
