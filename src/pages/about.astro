---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, authors } from "../lib/blog-data.js";

export const prerender = true;
---

<BaseLayout
  title={`About - ${SITE.name}`}
  description={`About ${SITE.name}: a curated collection of the best free crochet patterns, tutorials, and handmade inspiration.`}
  canonical="/about"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "About" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">About</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05] tracking-tight">
        Sharing the best free crochet patterns with you.
      </h1>
    </header>

    <div class="prose-article mt-10">
      <p>
        Hello, dear crocheters! Welcome to <strong>{SITE.name}</strong> &mdash; your go-to destination for discovering the best free crochet patterns from talented designers around the world.
      </p>

      <p>
        Our mission is simple: to share beautiful, free crochet patterns for you, your family, and your home. Whether you're a complete beginner picking up a hook for the first time or a seasoned crocheter looking for your next project, we've curated something special for every skill level.
      </p>

      <h2 id="what-we-do">What We Do</h2>
      <p>
        {SITE.name} is a curated directory &mdash; we do not feature our own designs, but rather our editors' carefully selected favorites from across the crochet community. Every pattern we share has been hand-picked for its quality, clarity, and beauty.
      </p>
      <p>
        We do not collect or redistribute photographs. All images on our site are used as examples of the inspiring work featured in our articles. We always give full copyright credit to every photo and link back to the original designer's page.
      </p>

      <h2 id="what-you-will-find">What You'll Find Here</h2>
      <ul>
        <li><strong>Pattern Roundups</strong> &mdash; curated collections like "15 Best Baby Blanket Patterns" and "10 Adorable Amigurumi Animals"</li>
        <li><strong>Tutorials & Tips</strong> &mdash; helpful guides on stitches, techniques, and tools</li>
        <li><strong>Yarn Reviews</strong> &mdash; honest reviews of popular yarns for different project types</li>
        <li><strong>Seasonal Inspiration</strong> &mdash; holiday patterns, gift ideas, and trending designs</li>
      </ul>

      <h2 id="for-designers">For Pattern Designers</h2>
      <p>
        We love supporting independent crochet designers. If you'd like your patterns featured on {SITE.name}, or if you have any questions or concerns about your work appearing on our site, please don't hesitate to <a href="/contact">reach out to us</a>.
      </p>
      <p>
        We always link back to the original source and give full credit. If you would like any content modified or removed, we will promptly comply with your request.
      </p>

      <h2 id="contact">Get in Touch</h2>
      <p>
        Have a question, suggestion, or just want to say hello? We'd love to hear from you! Reach us at <a href="mailto:contact@softcrochet.com">contact@softcrochet.com</a> or visit our <a href="/contact">contact page</a>.
      </p>

      <p>Happy crocheting! 🧶</p>
    </div>

    <section class="mt-12 border-t border-border pt-10">
      <h2 class="font-serif text-2xl font-semibold tracking-tight">Our Team</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          authors.map((author) => (
            <a href={`/authors/${author.slug}`} class="group flex items-start gap-3">
              <img src={author.avatar} alt="" width="48" height="48" class="h-12 w-12 rounded-full" />
              <div>
                <div class="font-serif text-base font-semibold group-hover:text-primary">{author.name}</div>
                <div class="mt-1 text-sm text-muted-foreground">{author.bio}</div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
