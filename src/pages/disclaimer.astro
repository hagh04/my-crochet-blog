---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../lib/blog-data.js";

export const prerender = true;

const lastUpdated = "June 27, 2026";
---

<BaseLayout
  title={`Disclaimer - ${SITE.name}`}
  description={`Disclaimer and disclosure information for ${SITE.name}.`}
  canonical="/disclaimer"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "Disclaimer" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Legal</div>
      <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight sm:text-5xl">Disclaimer</h1>
      <p class="mt-3 text-sm text-muted-foreground">Last updated: {lastUpdated}</p>
    </header>

    <div class="prose-article mt-10">
      <h2 id="general-disclaimer">General Disclaimer</h2>
      <p>
        The information provided on {SITE.name} (<a href="https://softcrochet.com">softcrochet.com</a>) is for general informational and inspirational purposes only.
        While we strive to keep the information accurate and up to date, we make no representations or warranties of any kind, express or implied, about the completeness, accuracy, reliability, or availability of any information, patterns, or related images on the website.
      </p>

      <h2 id="pattern-disclaimer">Pattern & Content Disclaimer</h2>
      <p>
        {SITE.name} is a curated directory that features free crochet patterns created by independent designers. We do not create the patterns ourselves. All patterns featured on our site are the intellectual property of their respective creators.
      </p>
      <p>
        We always provide credit and link back to the original source. If you are a pattern designer and would like your work removed from our site, please <a href="/contact">contact us</a> and we will promptly comply.
      </p>
      <p>
        We do not guarantee that patterns linked from our site will always be free, available, or error-free. Pattern terms, availability, and pricing are determined solely by the original creator.
      </p>

      <h2 id="affiliate-disclosure">Affiliate Disclosure (FTC Compliance)</h2>
      <p>
        In accordance with the Federal Trade Commission (FTC) guidelines, we disclose that {SITE.name} may contain affiliate links. This means we may earn a small commission if you click through and make a purchase, at no additional cost to you.
      </p>
      <p>
        Affiliate relationships do not influence our editorial decisions. We only recommend products and resources that we genuinely believe will be helpful to our readers.
      </p>
      <p>
        Affiliate partnerships may include (but are not limited to) yarn retailers, craft supply stores, and online marketplaces such as Amazon, Etsy, and LoveCrafts.
      </p>

      <h2 id="sponsored-content">Sponsored Content</h2>
      <p>
        From time to time, we may publish sponsored content or partner with brands. Sponsored posts will always be clearly marked as "Sponsored" or "In partnership with" the relevant brand. Our opinions remain our own regardless of sponsorship.
      </p>

      <h2 id="image-copyright">Image Copyright</h2>
      <p>
        Images used on {SITE.name} are used as examples of inspiring crochet work. We always provide credit and link back to the original photographer or designer. We do not claim ownership of images created by others.
      </p>
      <p>
        If you are the owner of an image featured on our site and would like it removed or credited differently, please <a href="/contact">contact us</a> and we will address your request promptly.
      </p>

      <h2 id="external-links-disclaimer">External Links Disclaimer</h2>
      <p>
        Our site contains links to external websites that are not maintained by us. We do not have control over the content, privacy policies, or practices of any third-party websites and accept no responsibility for them. Visiting external links is at your own discretion and risk.
      </p>

      <h2 id="no-professional-advice">No Professional Advice</h2>
      <p>
        The content on this website is for entertainment and informational purposes only. Nothing on this site constitutes professional, medical, legal, or financial advice.
      </p>

      <h2 id="contact">Questions?</h2>
      <p>If you have any questions about this disclaimer, please reach out:</p>
      <ul>
        <li>Email: <a href="mailto:contact@softcrochet.com">contact@softcrochet.com</a></li>
        <li>Website: <a href="/contact">Contact Page</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
